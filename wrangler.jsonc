{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshi-keiba",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  // 認証情報と SESSION_SECRET は Cloudflare Secrets で設定する。
  // この4項目が未設定なら、本番 deploy を失敗させる（値はここへ書かない）。
  "secrets": {
    "required": ["ADMIN_PASSWORD", "ADMIN_USER_ID", "MEMBER_PASSWORD", "SESSION_SECRET"]
  },
  // secrets.required があると .dev.vars は上の4項目だけ読む。
  // デモ初期化は vars（本番は 0）。ローカルは npm run dev の --var で 1 にする。
  "vars": {
    "ALLOW_DEMO_RESET": "0"
  },
  // 認証4項目のローカル値は Git 管理しない .dev.vars に置く。
  "workers_dev": true,
  // 場内背景（日中／夕方／ナイター）。Worker 未一致のパスだけ静的配信
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/twinkle/*",
      "/images/umamusume/stand/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oshi-keiba",
      "database_id": "7145055f-edbc-4991-88bb-9ee62ce1a9f1",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOTS",
      // 本番デプロイ前に忘れない:
      // 1. npx wrangler r2 bucket create oshi-keiba-shots（初回だけ）
      // 2. npx wrangler d1 migrations apply oshi-keiba --remote
      // 3. npm run deploy
      // 詳細は docs/specifications/ocr.md の「デプロイ（忘れない）」
      "bucket_name": "oshi-keiba-shots"
    }
  ]
}
