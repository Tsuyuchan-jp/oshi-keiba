{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshi-keiba",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "vars": {
    // 試運転: 管理者は当面 demo-admin。メンバー共有パスは loh
    "ADMIN_PASSWORD": "demo-admin",
    "MEMBER_PASSWORD": "loh"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oshi-keiba",
      "database_id": "7145055f-edbc-4991-88bb-9ee62ce1a9f1",
      "migrations_dir": "./migrations"
    }
  ]
}
