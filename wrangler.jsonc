{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshi-keiba",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "vars": {
    // 試運転: 管理者は当面 demo-admin。メンバー共有パスは loh
    "ADMIN_PASSWORD": "demo-admin",
    "MEMBER_PASSWORD": "loh"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oshi-keiba",
      "database_id": "7145055f-edbc-4991-88bb-9ee62ce1a9f1",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOTS",
      // 本番デプロイ前に忘れない:
      // 1. npx wrangler r2 bucket create oshi-keiba-shots（初回だけ）
      // 2. npx wrangler d1 migrations apply oshi-keiba --remote
      // 3. npm run deploy
      // 詳細は docs/ocr.md の「デプロイ（忘れない）」
      "bucket_name": "oshi-keiba-shots"
    }
  ]
}
