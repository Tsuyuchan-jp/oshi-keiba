{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "worker-configuration.d.ts", "package.json"],
  "exclude": ["src/**/*.test.ts"]
}
